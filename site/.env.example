# Copy this file to ".env". Values come from https://www.sanity.io/manage
# If PUBLIC_SANITY_PROJECT_ID is empty, the site runs in "sample mode" using src/lib/sample.ts.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# ---- Preview site only (the one the editor's live preview shows) -----------------
# Leave these out on the PUBLIC site.
SANITY_PREVIEW_SITE=true
PUBLIC_SANITY_STUDIO_URL=https://becca-worthington.sanity.studio
# A "Viewer" token (sanity.io/manage → API → Tokens). Lets the preview read drafts. Keep it secret.
SANITY_API_READ_TOKEN=
