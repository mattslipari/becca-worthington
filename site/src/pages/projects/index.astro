---
import Base from '../../layouts/Base.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import {getProjects} from '../../lib/content'
const projects = await getProjects(Astro)
---
<Base title="Projects">
  <section class="container section first">
    <SectionHeading text="Projects" />
    {projects.length ? <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div> : <p class="muted">Coming soon.</p>}
  </section>
</Base>
<style>.first { margin-top: clamp(1.5rem, 4vw, 3rem); }</style>
