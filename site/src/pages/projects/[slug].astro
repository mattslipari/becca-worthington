---
import Base from '../../layouts/Base.astro'
import Img from '../../components/Img.astro'
import RichText from '../../components/RichText.astro'
import VideoEmbed from '../../components/VideoEmbed.astro'
import {getProjects} from '../../lib/content'
import type {Project} from '../../lib/types'

// Public site: every project page is generated ahead of time.
export async function getStaticPaths() {
  const projects = await getProjects({locals: {preview: false}})
  return projects.map((project) => ({params: {slug: project.slug}}))
}
// Preview site: pages are rendered on demand, so look the project up from the URL
// (this also picks up brand-new projects that haven't been published yet).
const project = (await getProjects(Astro)).find((p) => p.slug === Astro.params.slug) as Project | undefined
if (!project) return Astro.rewrite('/404')
const hasCover = project.coverImage?.asset || project.coverImage?.src
---
<Base title={project.title} description={project.summary}>
  <article class="container section first">
    <p class="back"><a href="/projects">← All projects</a></p>
    {project.kind && <p class="kind">{project.kind}</p>}
    <h1>{project.title}</h1>
    {project.summary && <p class="lede">{project.summary}</p>}
    {hasCover && <div class="cover"><Img photo={project.coverImage} width={1100} loading="eager" /></div>}
    {project.videoUrl && <div class="cover"><VideoEmbed url={project.videoUrl} title={project.title} /></div>}
    <RichText value={project.body} class="body" />
    {project.links?.length ? (
      <div class="btn-row">
        {project.links.map((l) => <a class="btn" href={l.url} target={l.url.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a>)}
      </div>
    ) : null}
  </article>
</Base>
<style>
  .first { margin-top: clamp(1.5rem, 4vw, 3rem); max-width: 820px; }
  .back a { text-decoration: none; font-size: 0.9rem; letter-spacing: 0.08em; }
  .kind { font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-soft); margin-bottom: 0.25rem; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); text-transform: uppercase; }
  .lede { font-size: 1.2rem; }
  .cover { margin-block: 2rem; border-radius: var(--radius); overflow: hidden; }
  .cover :global(img) { width: 100%; height: auto; }
  article :global(.body) { margin-bottom: 2rem; }
</style>
