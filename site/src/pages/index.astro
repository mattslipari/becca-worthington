---
import Base from '../layouts/Base.astro'
import Slideshow from '../components/Slideshow.astro'
import Sparkle from '../components/Sparkle.astro'
import RichText from '../components/RichText.astro'
import SocialLinks from '../components/SocialLinks.astro'
import Sections from '../components/sections/Sections.astro'
import {getHome, getSettings} from '../lib/content'
import {DOCS, clean} from '../lib/visualEditing'

const [settings, home] = await Promise.all([getSettings(Astro), getHome(Astro)])
const sparkles = settings.showSparkles !== false
---
<Base>
  <section class="hero-wrap">
    <div class="container hero on-block">
      <div class="hero-text">
        <h1>
          {settings.name}
          {sparkles && <span class="sparkles" aria-hidden="true"><Sparkle size={34} /><Sparkle size={18} /></span>}
        </h1>
        {settings.tagline && <p class="tagline">{settings.tagline}</p>}
        <div class="btn-row">
          <a class="btn" href="/resume">Resume</a>
          <a class="btn" href="/reels">Reels</a>
          {settings.email && <a class="btn ghost" href={`mailto:${clean(settings.email)}`}>Email me</a>}
        </div>
        <div class="hero-socials"><SocialLinks social={settings.social} /></div>
      </div>
      <div class="hero-photo framed"><Slideshow photos={home.heroPhotos} doc={DOCS.home} /></div>
    </div>
  </section>

  {home.bio?.length ? (
    <section class="container section about">
      <div class="section-title center">
        {sparkles && <Sparkle size={26} />}
        <h2>{home.bioHeading || 'About me'}</h2>
      </div>
      <RichText value={home.bio} class="bio" />
    </section>
  ) : null}

  <Sections sections={home.sections} doc={DOCS.home} />
</Base>

<style>
  .hero-wrap { padding-top: clamp(0.75rem, 2.5vw, 2rem); }
  .hero {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    padding: clamp(1.75rem, 5vw, 4.5rem);
  }
  h1 {
    position: relative; margin: 0 0 1.25rem;
    font-family: var(--font-wide); font-weight: 800; letter-spacing: 0.01em; line-height: 1;
    /* sized so the longest word fits the column (cqi = % of the text column's width) */
    font-size: clamp(2rem, 12cqi, 5.4rem); color: var(--on-block);
    hyphens: manual; text-wrap: balance;
  }
  .sparkles { position: absolute; top: -0.9em; left: -0.4em; display: flex; align-items: flex-start; color: var(--block-accent); }
  .sparkles :global(svg:last-child) { margin-top: 1.5rem; margin-left: -2px; }
  .tagline {
    margin: 0 0 2rem; color: var(--block-accent);
    font-family: var(--font-wide); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.2em; font-size: clamp(0.95rem, 1.7vw, 1.25rem); line-height: 1.45;
  }
  .hero-text { container-type: inline-size; }
  .hero-socials { margin-top: 1.75rem; }
  .hero-photo { transform: rotate(1.5deg); }
  .hero-photo :global(.track) { border-radius: 0; }

  .about { max-width: 780px; }
  .about :global(.bio) { font-size: 1.15rem; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero-photo { max-width: 460px; width: 100%; justify-self: center; transform: none; }
    .hero-text { display: contents; }
    h1 { order: 0; margin-bottom: 0.75rem; font-size: clamp(1.9rem, 8.4vw, 3.6rem); }
    .tagline { order: 1; margin-bottom: 0.5rem; }
    .hero-photo { order: 2; }
    .btn-row { order: 3; justify-content: center; }
    .btn-row .btn { min-width: 0; padding-inline: 1.15rem; }
    .hero-socials { order: 4; margin: 0; display: flex; justify-content: center; }
    h1, .tagline { text-align: center; }
    .sparkles { display: none; }
  }
</style>
