---
import Base from '../layouts/Base.astro'
import Slideshow from '../components/Slideshow.astro'
import Sparkle from '../components/Sparkle.astro'
import RichText from '../components/RichText.astro'
import SocialLinks from '../components/SocialLinks.astro'
import Sections from '../components/sections/Sections.astro'
import {getHome, getSettings} from '../lib/content'
import {DOCS, clean} from '../lib/visualEditing'

const [settings, home] = await Promise.all([getSettings(Astro), getHome(Astro)])
---
<Base>
  <section class="hero container">
    <div class="hero-photo"><Slideshow photos={home.heroPhotos} doc={DOCS.home} /></div>
    <div class="hero-text">
      <h1>
        <span class="name">{settings.name}</span>
        {settings.showSparkles !== false && <span class="sparkles"><Sparkle size={30} /><Sparkle size={16} /></span>}
      </h1>
      {settings.tagline && <p class="tagline">{settings.tagline}</p>}
      <RichText value={home.bio} class="bio" />
      <div class="btn-row">
        <a class="btn" href="/resume">Resume</a>
        <a class="btn" href="/reels">Reels</a>
        {settings.email && <a class="btn" href={`mailto:${clean(settings.email)}`}>Email me</a>}
      </div>
      <div class="hero-socials"><SocialLinks social={settings.social} /></div>
    </div>
  </section>

  <Sections sections={home.sections} doc={DOCS.home} />
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: start; padding-top: clamp(1rem, 4vw, 3rem); }
  h1 { font-size: clamp(2.4rem, 5.4vw, 4.6rem); text-transform: uppercase; margin-bottom: 0.4rem; position: relative; padding-right: 2.25rem; overflow-wrap: break-word; }
  .sparkles { position: absolute; top: -0.35em; right: 0; display: flex; align-items: flex-start; gap: 0; }
  .sparkles :global(svg:last-child) { margin-top: 1.4rem; margin-left: -4px; }
  .tagline { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: clamp(1rem, 2vw, 1.2rem); padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); margin: 0 0 1.5rem; }
  .hero-text :global(.bio) { max-width: 38rem; margin-bottom: 1.75rem; }
  .hero-socials { margin-top: 1.75rem; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; }
    .hero-photo { order: 2; }
    .hero-text { display: contents; }
    h1 { order: 0; } .tagline { order: 1; }
    .hero-text :global(.bio) { order: 3; } .btn-row { order: 4; } .hero-socials { order: 5; }
  }
</style>
