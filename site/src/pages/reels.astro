---
import Base from '../layouts/Base.astro'
import VideoEmbed from '../components/VideoEmbed.astro'
import PageHeader from '../components/PageHeader.astro'
import Sections from '../components/sections/Sections.astro'
import {getReelsPage} from '../lib/content'
import {DOCS, sanityAttr} from '../lib/visualEditing'
const key = (r: any) => sanityAttr(Astro, DOCS.reelsPage, `reels[_key=="${r._key}"]`)

const page = await getReelsPage(Astro)
const [first, ...rest] = page.reels || []
---
<Base title="Reels & Videos">
  <PageHeader title="Reels & Videos" intro={page.intro} />
  <section class="container section">
    {first && (
      <figure class="feature" data-sanity={key(first)}>
        <VideoEmbed url={first.url} title={first.title} />
        <figcaption><strong>{first.title}</strong>{first.note && <span class="muted"> – {first.note}</span>}</figcaption>
      </figure>
    )}
    {rest.length > 0 && (
      <div class="grid">
        {rest.map((r) => (
          <figure data-sanity={key(r)}>
            <VideoEmbed url={r.url} title={r.title} />
            <figcaption><strong>{r.title}</strong>{r.category && <span class="muted"> · {r.category}</span>}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>
  <Sections sections={page.sections} doc={DOCS.reelsPage} tintFirst />
</Base>
<style>
  figure { margin: 0; }
  figcaption { margin-top: 0.9rem; line-height: 1.35; text-align: center; }
  .grid { gap: 2rem; }
  .feature { max-width: 960px; margin: 0 auto clamp(2.5rem, 6vw, 4rem); }
  .feature figcaption { font-size: 1.2rem; }
</style>
