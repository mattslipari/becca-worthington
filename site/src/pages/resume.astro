---
import Base from '../layouts/Base.astro'
import Img from '../components/Img.astro'
import PageHeader from '../components/PageHeader.astro'
import SectionHeading from '../components/SectionHeading.astro'
import Sections from '../components/sections/Sections.astro'
import {getResume} from '../lib/content'
import {originalUrl} from '../lib/sanity'
import {DOCS, sanityAttr} from '../lib/visualEditing'

const resume = await getResume(Astro)
const headshots = resume.headshots || []
const groups = (resume.creditGroups || []).filter((g) => g.credits?.length)
---
<Base title="Resume & Headshots">
  <PageHeader title="Resume & Headshots" intro={resume.intro}>
    {resume.resumePdfUrl && (
      <div class="btn-row"><a class="btn" href={`${resume.resumePdfUrl}?dl=`} download>Download resume</a></div>
    )}
  </PageHeader>

  {headshots.length > 0 && (
    <section class="container section">
      <SectionHeading text="Headshots" />
      <div class="headshots">
        {headshots.map((photo) => {
          const full = originalUrl(photo)
          return (
            <figure>
              <div class="framed"><Img photo={photo} width={480} height={600} label="Headshot" sanity={sanityAttr(Astro, DOCS.resume, `headshots[_key=="${(photo as any)._key}"]`)} /></div>
              <figcaption>
                {photo.caption && <span>{photo.caption}</span>}
                {full && <a class="btn ghost" href={full} download>Download headshot</a>}
              </figcaption>
            </figure>
          )
        })}
      </div>
    </section>
  )}

  {groups.length > 0 && (
    <div class="band-tint">
      <section class="container section credits">
        <SectionHeading text="Credits" />
        <div class="sheet card">
          {groups.map((group) => (
            <div class="group">
              <h3>{group.heading}</h3>
              <table>
                <tbody>
                  {group.credits!.map((c) => (
                    <tr>
                      <td class="prod">{c.production}</td>
                      <td>{c.role}</td>
                      <td class="muted">{[c.company, c.year].filter(Boolean).join(' · ')}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
          {resume.skills && (
            <div class="group">
              <h3>Special skills</h3>
              <p>{resume.skills}</p>
            </div>
          )}
        </div>
      </section>
    </div>
  )}

  <Sections sections={resume.sections} doc={DOCS.resume} tintFirst={groups.length === 0} />
</Base>

<style>
  .headshots { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(1.5rem, 4vw, 3rem); }
  figure { margin: 0; flex: 0 1 340px; }
  figure .framed { aspect-ratio: 4 / 5; }
  figure:nth-child(odd) .framed { transform: rotate(-1.25deg); }
  figure:nth-child(even) .framed { transform: rotate(1.25deg); }
  figcaption { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; margin-top: 1.25rem; text-align: center; font-size: 0.95rem; }

  .sheet { padding: clamp(1.5rem, 4vw, 3rem); max-width: 980px; margin-inline: auto; }
  .group + .group { margin-top: 2.25rem; }
  .group h3 { color: var(--accent); font-size: 1.5rem; padding-bottom: 0.4rem; border-bottom: 2px solid var(--accent); margin-bottom: 0.25rem; }
  .group p { margin: 0.75rem 0 0; }
  table { width: 100%; border-collapse: collapse; }
  td { padding: 0.65rem 1rem 0.65rem 0; border-bottom: 1px solid var(--line); vertical-align: top; width: 33%; }
  tr:last-child td { border-bottom: 0; }
  .prod { font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.95rem; }
  @media (max-width: 640px) {
    tr { display: block; padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
    tr:last-child { border-bottom: 0; }
    td { display: block; border: 0; padding: 0; width: auto; }
  }
</style>
