---
import Img from './Img.astro'
import {parseVideo} from '../lib/video'
import type {Project} from '../lib/types'
interface Props { project: Project }
const {project} = Astro.props
const thumb = !project.coverImage?.asset && !project.coverImage?.src ? parseVideo(project.videoUrl)?.thumbnail : undefined
---
<a class="project card" href={`/projects/${project.slug}`}>
  <div class="cover">
    {thumb ? <img src={thumb} alt="" loading="lazy" /> : <Img photo={project.coverImage} width={640} height={400} label={project.title} />}
  </div>
  {project.kind && <p class="eyebrow kind">{project.kind}</p>}
  <h3>{project.title}</h3>
  {project.summary && <p class="muted">{project.summary}</p>}
  <span class="more">Read more →</span>
</a>
<style>
  .project { display: flex; flex-direction: column; text-decoration: none; padding: 0; overflow: hidden; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .project:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12); }
  .cover { aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 4px solid var(--accent); }
  .cover :global(img), .cover :global(.placeholder-img) { width: 100%; height: 100%; object-fit: cover; }
  .kind { margin: 1.25rem 1.5rem 0.25rem; }
  h3 { margin: 0 1.5rem 0.5rem; }
  .project > p.muted { margin: 0 1.5rem 1rem; }
  .more { margin: auto 1.5rem 1.5rem; font-family: var(--font-wide); font-size: 0.85rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
</style>
