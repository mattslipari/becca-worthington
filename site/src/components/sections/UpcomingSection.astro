---
import Img from '../Img.astro'
import SectionHeading from '../SectionHeading.astro'
import type {Section, Event} from '../../lib/types'
interface Props { section: Section }
const {section} = Astro.props
const events: Event[] = section.events || []
---
{events.length > 0 && (
  <section class="container section">
    <SectionHeading text={section.heading} />
    <div class="events">
      {events.map((e) => (
        <article class="event card">
          {(e.image?.asset || e.image?.src) && <div class="img"><Img photo={e.image} width={400} height={400} /></div>}
          <div>
            {e.when && <p class="when">{e.when}</p>}
            <h3>{e.title}</h3>
            {e.role && <p class="muted">as {e.role}</p>}
            {e.where && <p>{e.where}</p>}
            {e.link && <a class="btn" href={e.link} target="_blank" rel="noopener">Tickets & info</a>}
          </div>
        </article>
      ))}
    </div>
  </section>
)}
<style>
  .events { display: grid; gap: 1.25rem; }
  .event { display: flex; gap: 1.5rem; align-items: center; }
  .event { border-left: 6px solid var(--accent); }
  .event .img { flex: 0 0 140px; aspect-ratio: 1; overflow: hidden; }
  .event .img :global(*) { width: 100%; height: 100%; object-fit: cover; }
  .event p { margin: 0 0 0.35rem; }
  .event h3 { margin-bottom: 0.25rem; }
  .when { font-family: var(--font-wide); font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700; color: var(--accent); }
  .event .btn { margin-top: 0.75rem; }
  @media (max-width: 560px) { .event { flex-direction: column; align-items: stretch; } .event .img { flex-basis: auto; aspect-ratio: 16/10; } }
</style>
