---
import SectionHeading from '../SectionHeading.astro'
import SocialLinks from '../SocialLinks.astro'
import {getSettings} from '../../lib/content'
import type {Section} from '../../lib/types'
import {clean} from '../../lib/visualEditing'
interface Props { section: Section }
const {section} = Astro.props
const settings = await getSettings(Astro)
const reps = settings.representatives || []
---
<section class="container section">
  <SectionHeading text={section.heading || 'Contact'} id="contact" />
  {section.intro && <p class="intro">{section.intro}</p>}
  <div class="grid">
    {reps.map((r) => (
      <div class="card rep">
        {r.region && <p class="region">{r.region}</p>}
        <h3>{r.website ? <a href={r.website} target="_blank" rel="noopener">{r.agency}</a> : r.agency}</h3>
        {r.contactName && <p>{r.contactName}</p>}
        {r.email && <p><a href={`mailto:${clean(r.email)}`}>{r.email}</a></p>}
        {r.phone && <p><a href={`tel:${clean(r.phone).replace(/[^+\d]/g, '')}`}>{r.phone}</a></p>}
      </div>
    ))}
    {settings.email && (
      <div class="card rep">
        <p class="region">Direct</p>
        <h3>Email me</h3>
        <p><a href={`mailto:${clean(settings.email)}`}>{settings.email}</a></p>
      </div>
    )}
  </div>
  <div class="socials"><SocialLinks social={settings.social} /></div>
</section>
<style>
  .intro { max-width: 640px; margin-top: -0.5rem; margin-bottom: 1.75rem; }
  .rep p { margin: 0 0 0.25rem; overflow-wrap: anywhere; }
  .rep h3 { margin-bottom: 0.5rem; }
  .rep h3 a { text-decoration: none; }
  .region { font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-soft); }
  .socials { margin-top: 2rem; }
</style>
