---
import ProjectCard from '../ProjectCard.astro'
import SectionHeading from '../SectionHeading.astro'
import {getProjects} from '../../lib/content'
import type {Section} from '../../lib/types'
interface Props { section: Section }
const {section} = Astro.props
const projects = (await getProjects(Astro)).filter((p) => p.featured)
---
{projects.length > 0 && (
  <section class="container section">
    <SectionHeading text={section.heading} />
    <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    <p class="all"><a class="btn" href="/projects">All projects</a></p>
  </section>
)}
<style>.all { margin-top: 2rem; }</style>
