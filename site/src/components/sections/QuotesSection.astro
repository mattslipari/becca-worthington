---
import SectionHeading from '../SectionHeading.astro'
import type {Section, Quote} from '../../lib/types'
interface Props { section: Section }
const {section} = Astro.props
const quotes: Quote[] = section.quotes || []
---
{quotes.length > 0 && (
  <section class="container section">
    <SectionHeading text={section.heading} />
    <div class="grid">
      {quotes.map((q) => (
        <blockquote class="card">
          <p>{q.text}</p>
          {q.source && (
            <footer>
              — {q.link ? <a href={q.link} target="_blank" rel="noopener">{q.source}</a> : q.source}
            </footer>
          )}
        </blockquote>
      ))}
    </div>
  </section>
)}
<style>
  blockquote { margin: 0; position: relative; padding-top: 2.75rem; }
  blockquote::before { content: '“'; position: absolute; top: 0.25rem; left: 1.25rem; font-family: var(--font-display); font-size: 4.5rem; line-height: 1; color: var(--accent); }
  blockquote p { font-size: 1.2rem; line-height: 1.5; font-style: italic; margin: 0 0 1rem; }
  footer { font-family: var(--font-wide); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
</style>
