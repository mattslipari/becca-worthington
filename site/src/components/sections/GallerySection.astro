---
import Img from '../Img.astro'
import SectionHeading from '../SectionHeading.astro'
import type {Section, Photo} from '../../lib/types'
interface Props { section: Section }
const {section} = Astro.props
const photos: Photo[] = section.photos || []
---
{photos.length > 0 && (
  <section class="container section">
    <SectionHeading text={section.heading} />
    <div class="gallery">
      {photos.map((photo) => (
        <figure>
          <div class="framed"><Img photo={photo} width={600} /></div>
          {photo.caption && <figcaption class="muted">{photo.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </section>
)}
<style>
  .gallery { columns: 3 260px; column-gap: clamp(1rem, 2.5vw, 1.75rem); }
  figure { margin: 0 0 clamp(1rem, 2.5vw, 1.75rem); break-inside: avoid; }
  figure :global(img) { height: auto; }
  figure :global(.placeholder-img) { aspect-ratio: 4/5; }
  figcaption { font-size: 0.85rem; margin-top: 0.5rem; text-align: center; }
</style>
