---
{entries.length > 0 && (
  <ul class="socials">
    {entries.map(([key, icon]) => (
      <li>
        <a href={social[key as keyof typeof social]} target="_blank" rel="noopener" aria-label={icon.label} title={icon.label}>
          <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><path d={icon.path} fill="currentColor" /></svg>
        </a>
      </li>
    ))}
  </ul>
)}
<style>
  .socials { display: flex; gap: 1rem; list-style: none; padding: 0; margin: 0; flex-wrap: wrap; }
  .socials a { display: inline-flex; color: var(--text); transition: transform 0.15s ease, color 0.15s ease; }
  .socials a:hover { color: var(--accent); transform: translateY(-2px); }
</style>
