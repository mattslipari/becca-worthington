---
import SocialLinks from './SocialLinks.astro'
import type {Settings} from '../lib/types'
import {clean} from '../lib/visualEditing'
interface Props { settings: Settings }
const {settings} = Astro.props
---
<footer class="site-footer">
  <div class="container inner">
    <SocialLinks social={settings.social} size={24} />
    {settings.email && <a href={`mailto:${clean(settings.email)}`}>{settings.email}</a>}
    <p class="muted">© {new Date().getFullYear()} {settings.name}</p>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: var(--section-gap); padding-block: 2.5rem; }
  .inner { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; justify-content: space-between; }
  .inner p { margin: 0; font-size: 0.9rem; }
</style>
